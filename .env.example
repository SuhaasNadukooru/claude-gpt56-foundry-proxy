# Enter these locally, then copy this file to .env and set permissions to 600.
# Either an Azure OpenAI resource base URL or an OpenAI v1 base URL is accepted:
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
FOUNDRY_API_KEY=PASTE_YOUR_FOUNDRY_API_KEY_HERE
FOUNDRY_DEPLOYMENT=YOUR_GPT_5_6_SOL_DEPLOYMENT_NAME
# api-key is the documented API-key header. Set to bearer only for an Entra token.
FOUNDRY_AUTH_MODE=api-key
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
# Optional local token used only between Claude Code and this local proxy.
LOCAL_GATEWAY_TOKEN=local-proxy
